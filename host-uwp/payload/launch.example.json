// launch.example.json - every key of LocalState\launch.json with its default value.
//
// THIS FILE IS REPLACED by a fresh copy from the package each time win10xbox starts: it is
// documentation. To change anything, copy it to launch.json in this folder (or write a new
// launch.json) and edit THAT file; the package never overwrites it. Without a launch.json in
// this folder the host uses the packaged default (payload\launch.json, which runs the GUI guest
// window.exe, expects exit code 42 and keeps the app open afterwards), and without that the
// defaults shown below.
//
// Format: JSON with // and /* */ comments and trailing commas. UNKNOWN KEYS ARE AN ERROR: a
// typo must not silently run the default guest on a console that has no screen to tell you.
// Keys starting with "$" or "_" are free-form notes and ignored. In JSON every backslash of a
// path is written twice: "C:\\Program Files\\App\\app.exe".
//
// The results are plain files in this folder: status.txt (verdict and facts: read it first),
// trace.log, stdout.txt (the guest's stdout and stderr) and, if the host died, crash.txt and
// crash.dmp. entry-reached.txt exists once control reached the guest. screen.bmp is what was on
// screen (every 5 s while the guest runs, and when it has exited). The guest's C:\ is the
// folder machine\ here.
{
  // The program to run: a bare file name, looked up in C:\guest (machine\guest here), or an
  // absolute guest path. The package puts these there:
  //   window.exe       GUI: a solid blue window on the TV, exits 42 once painted and its timer
  //                    quit the loop (the packaged default)
  //   hello.exe        GUI subsystem, no window: facts to stdout.txt, exits 42
  //   hello_cui.exe    the same as a console program, exits 42
  //   smoke_cui.exe    host-uwp-lite's smoke guest (OS version, CPUID, clock facts), exits 42
  //   guest_hello.exe  prints "hello from guest", exits 42
  //   guest_cpuid.exe  prints CPUID leaf 1 ECX and the vendor, exits 0
  //   guest_sleep.exe  sleeps 4 x 5 ms, exits 7
  //   drv_client.exe   opens \\.\OurTestDevice: needs the driver host (drv_host), which
  //                    host-uwp does not run, so here it exits 2 ("cannot open")
  //   (guest_dll.dll is a library for loader tests, not a program)
  "guest": "hello.exe",

  // Command line arguments: an array of strings (each is quoted as needed) or one string that
  // is appended verbatim.
  "args": [],

  // The guest's current directory, an absolute guest path. "" = the layer's default
  // (C:\Users\<user>).
  "cwd": "",

  // Tracing, in the syntax of Wine's WINEDEBUG (WIN10XBOX_DEBUG): "+loader,+process", "+all", ...
  // "" = quiet, only err and fixme lines. Channels: modules, loader, process, vfs, dispatch,
  // registry, clock, token, cpu, nls, driver, winex, relay (every syscall: very large), all.
  // "+modules" is also the channel of the "guest entry reached" line that writes
  // entry-reached.txt. The host appends +modules for you, so you need not include it.
  "trace": "",

  // The same syntax for Wine's own channels (WIN10XBOX_WINEDEBUG), e.g. "+loaddll,warn+module"
  // to see which DLLs were loaded builtin or native and which imports Wine could not resolve.
  "winedebug": "",

  // Size cap of trace.log in MiB, 0 = unlimited. Lines past the cap are dropped.
  "trace_log_max_mb": 64,

  // Watchdog: end the run (and the app) after this many seconds, 0 = wait for the guest.
  "timeout_sec": 0,

  // Close the app when the guest has exited. false keeps it open until you close it.
  "exit_when_done": true,

  // With this key status.txt starts with PASS or FAIL against the guest's exit code; without
  // it the verdict is only "EXITED (the guest exited with code N ...)".
  // "expect_exit_code": 42,

  // Genuine DLLs to copy BY NAME from the console's own C:\Windows\System32 into the machine
  // folder (the console denies listing System32, but opens individual files). Bare file names.
  "stage_native": [],

  // Forward CoreWindow keyboard and pointer (and gamepad-as-keys) input to the winexbox
  // display backend.
  "input_pump": true,

  // The on-console launcher: a list of the bundled guests (and any .exe in LocalState\\guests)
  // drawn on the TV, chosen with the gamepad (D-pad / A / B) or keyboard (arrows / Enter / Esc).
  // After the guest exits the exit code and the last 20 lines of its output are shown; B
  // returns to the list. Default: on only when there is no launch.json at all.
  // "picker": true,
  // Test hook: launch this entry without waiting for input (implies "picker"); the result is
  // written to LocalState\\launcher_result.txt.
  // "autoselect": "hello_cui.exe",
}

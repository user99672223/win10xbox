<?xml version="1.0" encoding="utf-8"?>
<!--
  Package.appxmanifest - the real-UWP manifest for the capability probe.
  Shipping as a proper sandboxed C++/WinRT UWP with WinRT activation metadata
  (XboxProbe.winmd generated from App.idl by MSBuild / midlrt). The app class
  XboxProbe.App implements IFrameworkViewSource, so Xbox's launcher activates
  it the standard way instead of refusing the exe outright - which is what the
  FullTrust hack from v1.0.3.0 failed to work around on the console.

  TargetDeviceFamily is Windows.Universal because:
    * laptop AppContainer install needs Universal or Desktop;
    * Xbox App-partition install needs Universal (declaring only Desktop fails
      install with 0x80073CFD);
    * Xbox Game-partition install needs Windows.Xbox - we ADD it alongside
      Universal so a single msix can be installed into either bucket on Xbox
      ("App" or "Game" at upload time). The Game bucket gets the ~10 GB RAM /
      exclusive-cores budget we want for category M hardware numbers.

  Capabilities are deliberately restricted to the ones the probe needs. Device
  capabilities (musicLibrary, microphone, etc.) are dropped because they cause
  Xbox's shell to reject the manifest at launch, not because the probe doesn't
  touch them. The WinRT activation sweep still reports what's reachable.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 mp rescap">

  <Identity Name="XboxDevModeProbe"
            Publisher="CN=Dev"
            Version="1.0.4.0"
            ProcessorArchitecture="x64" />

  <mp:PhoneIdentity PhoneProductId="df3d1f17-dd30-4a9f-9b26-6c9b55e68a30"
                    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Xbox Dev Mode Probe</DisplayName>
    <PublisherDisplayName>Dev</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Xbox"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- EntryPoint names our WinRT activatable class, declared in App.idl and
         materialized as XboxProbe.winmd next to the exe inside the appx. The
         exe's wWinMain registers a factory for XboxProbe.App so Windows (and
         Xbox's launcher) can activate it, QueryInterface for
         IFrameworkViewSource, and call CreateView(). -->
    <Application Id="App" Executable="xbox-probe-uwp.exe" EntryPoint="XboxProbe.App">
      <uap:VisualElements DisplayName="Xbox Dev Mode Probe"
                          Description="Capability probe harness for the Xbox AppContainer / Xbox Game-partition sandboxes."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- codeGeneration: required for VirtualAlloc PAGE_EXECUTE_* under
         AppContainer. Entire category A depends on it being granted. -->
    <rescap:Capability Name="codeGeneration" />
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>

+/* The genuine user32's LoadStringW calls this export. */
+INT WINAPI DECLSPEC_HOTPATCH LoadStringBaseExW(HINSTANCE instance, UINT resource_id, LPWSTR buffer, INT buflen, WORD lang)
+{
+    return load_string(instance, resource_id, buffer, buflen, lang);
+}

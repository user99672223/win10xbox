win10xbox: kernelbase exports WTSGetServiceSessionId and WTSIsServerContainer

The genuine Windows user32.dll (gui=native) imports both from KERNELBASE.dll and calls
WTSGetServiceSessionId while initializing; Wine only had them as commented-out stubs, so the
loader bound a stub that raised EXCEPTION_WINE_STUB. The service session is 0 and this is not
a server container.

diff --git a/dlls/kernelbase/kernelbase.spec b/dlls/kernelbase/kernelbase.spec
index 2c5906a..cc298e3 100644
--- a/dlls/kernelbase/kernelbase.spec
+++ b/dlls/kernelbase/kernelbase.spec
@@ -1735,8 +1735,8 @@
 @ stdcall VirtualQuery(ptr ptr long)
 @ stdcall VirtualQueryEx(long ptr ptr long)
 @ stdcall VirtualUnlock(ptr long)
-# @ stub WTSGetServiceSessionId
-# @ stub WTSIsServerContainer
+@ stdcall WTSGetServiceSessionId()
+@ stdcall WTSIsServerContainer()
 @ stdcall WaitCommEvent(long ptr ptr)
 @ stdcall WaitForDebugEvent(ptr long)
 @ stdcall WaitForDebugEventEx(ptr long)
diff --git a/dlls/kernelbase/process.c b/dlls/kernelbase/process.c
index d16035f..e51a361 100644
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -1163,6 +1163,24 @@ BOOL WINAPI DECLSPEC_HOTPATCH ProcessIdToSessionId( DWORD pid, DWORD *id )
 }
 
 
+/***********************************************************************
+ *           WTSGetServiceSessionId   (kernelbase.@)
+ */
+DWORD WINAPI WTSGetServiceSessionId(void)
+{
+    return 0;
+}
+
+
+/***********************************************************************
+ *           WTSIsServerContainer   (kernelbase.@)
+ */
+BOOL WINAPI WTSIsServerContainer(void)
+{
+    return FALSE;
+}
+
+
 /***********************************************************************
  *           QueryProcessCycleTime   (kernelbase.@)
  */

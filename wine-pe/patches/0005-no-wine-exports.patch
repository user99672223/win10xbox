@@ -237,7 +232,7 @@ static void read_trashinfo_file( HANDLE handle, WIN32_FIND_DATAW *data )
         if (header && !strncmp( p, "Path=", 5 ))
         {
             p += 5;
-            if ((path = wine_get_dos_file_name( decode( p ))))
+            if ((path = unix_to_dos_name( decode( p ))))
             {
                 lstrcpynW( data->cFileName, path, MAX_PATH );
                 HeapFree( GetProcessHeap(), 0, path );
diff --git a/dlls/shell32/shell32_main.h b/dlls/shell32/shell32_main.h

-    const char *sysname;
-
-    wine_get_host_version( &sysname, NULL );
-    return !strcmp( sysname, "Darwin" );
+    return FALSE;  /* no unix host behind this build */
 }
 
 static BOOL WINAPI init_trash_dirs( INIT_ONCE *once, void *param, void **context )
@@ -198,7 +193,7 @@ static BOOL write_trashinfo_file( HANDLE handle, const WCHAR *orig_path )
     char *path, *buffer;
     SYSTEMTIME now;
 
-    if (!(path = wine_get_unix_file_name( orig_path ))) return FALSE;
+    if (!(path = dos_to_unix_name( orig_path ))) return FALSE;
     GetLocalTime( &now );
 

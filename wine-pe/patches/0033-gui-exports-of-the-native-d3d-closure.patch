win10xbox: user32/gdi32 exports the native dxgi, d3d11, d3d10warp and dwmapi look up and Wine's builtins lack

Found by the CI probe tools/ci/probe_delay_imports.ps1 (docs/slices/uwpswap.md round 13) and by the loader's lookup log
(0032): after CreateDXGIFactory1 the native dxgi resolves the D3DKMT entry points of the real gdi32 by name inside
IDXGIFactory::EnumAdapters and fail-fasts when one is missing (gdi32!D3DKMTSetVidPnSourceOwner1 STATUS_PROCEDURE_NOT_FOUND).

gdi32: D3DKMTSetVidPnSourceOwner1/2, RegisterTrimNotification, UnregisterTrimNotification, PinDirectFlipResources,
UnpinDirectFlipResources, SetDisplayPrivateDriverFormat, SignalSynchronizationObject2, WaitForSynchronizationObject2 (C
functions: Wine's win32u has no syscall for them), ScaleRgn and ScaleValues (dwmapi imports them).
user32: IsTopLevelWindow, GetWindowCompositionAttribute, IsOneCoreTransformMode (spec forwards to the win32u syscalls, which
core/user implements; they were spec stubs), DwmGetDxSharedSurface, IsThreadDesktopComposited,
SetWindowCompositionTransition, UpdateDefaultDesktopThumbnail (C functions).

diff --git a/dlls/gdi32/dc.c b/dlls/gdi32/dc.c
index adfcd51..37cf36a 100644
--- a/dlls/gdi32/dc.c
+++ b/dlls/gdi32/dc.c
@@ -2908,3 +2908,65 @@ BOOL WINAPI GdiGetDevmodeForPage( HANDLE h, DWORD page, DEVMODEW **cur, DEVMODEW
             return FALSE;
     }
 }
+
+/* D3DKMT entry points of the real gdi32 that have no win32u syscall in this tree (the native dxgi / d3d11 resolve them by
+ * name when the factory enumerates adapters). The guest has one emulated display and no kernel-mode driver: video-present
+ * source ownership is always granted, trim notifications are accepted and never fire, DirectFlip and the display private
+ * format are not supported, and the second-generation sync-object calls are not supported. */
+LONG WINAPI D3DKMTSetVidPnSourceOwner1( void *desc )
+{
+    return desc ? 0 : 0xC000000D; /* STATUS_SUCCESS, STATUS_INVALID_PARAMETER */
+}
+
+LONG WINAPI D3DKMTSetVidPnSourceOwner2( void *desc )
+{
+    return desc ? 0 : 0xC000000D;
+}
+
+LONG WINAPI D3DKMTRegisterTrimNotification( void **desc ) /* { callback, context, handle (out) } */
+{
+    if (!desc) return 0xC000000D;
+    desc[2] = (void *)(ULONG_PTR)1;
+    return 0;
+}
+
+LONG WINAPI D3DKMTUnregisterTrimNotification( void *desc )
+{
+    return desc ? 0 : 0xC000000D;
+}
+
+LONG WINAPI D3DKMTPinDirectFlipResources( void *desc )
+{
+    return 0xC00000BB; /* STATUS_NOT_SUPPORTED */
+}
+
+LONG WINAPI D3DKMTUnpinDirectFlipResources( void *desc )
+{
+    return 0xC00000BB;
+}
+
+LONG WINAPI D3DKMTSetDisplayPrivateDriverFormat( void *desc )
+{
+    return 0xC00000BB;
+}
+
+LONG WINAPI D3DKMTSignalSynchronizationObject2( void *desc )
+{
+    return 0xC00000BB;
+}
+
+LONG WINAPI D3DKMTWaitForSynchronizationObject2( void *desc )
+{
+    return 0xC00000BB;
+}
+
+/* DPI scaling helpers dwmapi imports: the scale of the emulated display is 1:1, so nothing changes. */
+BOOL WINAPI ScaleRgn( void *rgn, void *scale )
+{
+    return TRUE;
+}
+
+BOOL WINAPI ScaleValues( void *values, LONG count )
+{
+    return TRUE;
+}

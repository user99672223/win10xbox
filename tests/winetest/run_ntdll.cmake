# Runs Wine's ntdll conformance units (wine-pe/tests/ntdll.sh builds ntdll_test.exe)
# through win10xbox and gates on an explicit allowlist (cmake -P).
#
#   -DHOST=<win10xbox.exe> -DMACHINE=<machine dir> -DEXE=<ntdll_test.exe>
#   -DALLOWLIST=<wine-pe/tests/ntdll.allowlist> -DRESULTS_DIR=<dir>
#   [-DSURVEY=ON|OFF] [-DTIMEOUT=<s per allowlisted unit, 120>] [-DSURVEY_TIMEOUT=<s, 20>]
#   [-DEMULATOR=<wine>]
#
# Every unit in <EXE dir>/ntdll_test.units is run as
#   win10xbox --machine <MACHINE> C:\guest-wine\ntdll_test.exe <unit>
# Wine's test.h ends a unit with "<unit>: N tests executed (T marked as todo, F as
# flaky, K failures), S skipped."; a unit without that line crashed or timed out.
#
# GATE: a unit on the allowlist must print the line, with 0 failures and at least its
# floor of executed assertions. Units not on the allowlist are only measured (SURVEY):
# they never fail the test; their outcome, counts and first failing assertions go to
# <RESULTS_DIR>/summary.md and to the output, which is the todo list in
# docs/slices/wt-ntdll.md.
#
# PARITY (-DPARITY=<wine-pe/tests/ntdll.parity>, "<unit> <floor>" lines): units that cannot reach 0 failures on a
# Windows runner because Windows itself fails some of their assertions (the file unit: 26 of its 29 failures there
# are the runner's own, see docs/slices/wt-ntdll-file.md). They run as on Windows (--platform=windows: Wine's harness
# takes the guest for Wine, because its ntdll exports wine_get_version, and every todo_wine block would EXPECT a
# failure) and are gated against the same binary run natively on the same runner, without the layer: the unit must
# print its summary line, execute at least the floor of assertions, and fail no assertion (source line), in both of
# two runs through the layer, that Windows itself passes. Only where that comparison exists (a Windows host, no
# EMULATOR).
# Exits 77 (SKIP) when the Wine builtins, the NLS data or the guest are missing.
if(NOT TIMEOUT)
  set(TIMEOUT 120)
endif()
if(NOT SURVEY_TIMEOUT)
  set(SURVEY_TIMEOUT 20)
endif()
if("${SURVEY}" STREQUAL "")
  set(SURVEY ON)
endif()

# The summary line of the process that ran the unit. A unit that starts child processes (info, pipe, virtual...) shares
# its stdout with them, and each child prints a summary of its own ("0 tests executed"), before or after the parent's:
# the parent's is the one with the most assertions. Sets W10X_FOUND and W10X_EXEC/TODO/FAILED/SKIPPED in the caller.
function(w10x_pick_summary text)
  set(_re "([0-9]+) tests executed \\(([0-9]+) marked as todo, ([0-9]+) as flaky, ([0-9]+) failures?\\), ([0-9]+) skipped")
  string(REGEX MATCHALL "${_re}" _all "${text}")
  set(_best -1)
  foreach(_m IN LISTS _all)
    string(REGEX MATCH "${_re}" _x "${_m}")
    if(CMAKE_MATCH_1 GREATER _best)
      set(_best ${CMAKE_MATCH_1})
      set(_todo ${CMAKE_MATCH_2})
      set(_failed ${CMAKE_MATCH_4})
      set(_skipped ${CMAKE_MATCH_5})
    endif()
  endforeach()
  if(_best GREATER -1)
    set(W10X_FOUND TRUE PARENT_SCOPE)
    set(W10X_EXEC ${_best} PARENT_SCOPE)
    set(W10X_TODO ${_todo} PARENT_SCOPE)
    set(W10X_FAILED ${_failed} PARENT_SCOPE)
    set(W10X_SKIPPED ${_skipped} PARENT_SCOPE)
  else()
    set(W10X_FOUND FALSE PARENT_SCOPE)
  endif()
endfunction()

# Prints the summary line of a unit's log and one line per distinct failing assertion (diagnostics, see below).
function(w10x_summarize label unit log rc)
  file(READ "${log}" _text LIMIT 400000)
  string(REPLACE ";" "," _text "${_text}")
  string(REPLACE "[" "(" _text "${_text}")
  string(REPLACE "]" ")" _text "${_text}")
  w10x_pick_summary("${_text}")
  if(W10X_FOUND)
    message("WINETEST ${label} ntdll:${unit} executed=${W10X_EXEC} failed=${W10X_FAILED} todo=${W10X_TODO} skipped=${W10X_SKIPPED} exit=${rc}")
  else()
    message("WINETEST ${label} ntdll:${unit} did not finish, exit=${rc}")
  endif()
  string(REGEX MATCHALL "[A-Za-z0-9_]+\\.c:[0-9]+: Test (failed|succeeded inside todo block):[^\n]*" _fails "${_text}")
  set(_uniq "")
  foreach(_f IN LISTS _fails)
    string(REGEX MATCH "^[A-Za-z0-9_]+\\.c:[0-9]+" _key "${_f}")
    list(FIND _uniq "${_key}" _k)
    if(_k EQUAL -1)
      list(APPEND _uniq "${_key}")
      string(SUBSTRING "${_f}" 0 160 _f)
      string(REGEX REPLACE "[\r\n]+$" "" _f "${_f}")
      message("  ${label}: ${_f}")
    endif()
  endforeach()
endfunction()

# The source lines ("file.c:1719") of a unit log's failed assertions, in *out*.
function(w10x_failing_keys log out)
  file(READ "${log}" _text LIMIT 400000)
  string(REGEX MATCHALL "[A-Za-z0-9_]+\\.c:[0-9]+: Test failed" _fails "${_text}")
  set(_keys "")
  foreach(_f IN LISTS _fails)
    string(REGEX MATCH "^[A-Za-z0-9_]+\\.c:[0-9]+" _key "${_f}")
    list(APPEND _keys "${_key}")
  endforeach()
  list(REMOVE_DUPLICATES _keys)
  set(${out} "${_keys}" PARENT_SCOPE)
endfunction()

function(w10x_skip msg)
  message("SKIP: ${msg}")
  if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.29)
    cmake_language(EXIT 77)
  endif()
endfunction()

if(NOT EXISTS "${MACHINE}/Windows/builtin/ntdll.dll")
  w10x_skip("${MACHINE}/Windows/builtin/ntdll.dll missing: the Wine PE builtins (wine-pe artifact) are not staged")
  return()
endif()
if(NOT EXISTS "${MACHINE}/Windows/System32/c_1252.nls")
  w10x_skip("${MACHINE}/Windows/System32/c_1252.nls missing: the guest's ntdll needs the Windows NLS data")
  return()
endif()
if(NOT EXISTS "${EXE}")
  w10x_skip("${EXE} missing: build it with wine-pe/tests/ntdll.sh build (llvm-mingw + wine-pe/fetch-wine.sh)")
  return()
endif()
get_filename_component(_exe_dir "${EXE}" DIRECTORY)
if(NOT EXISTS "${_exe_dir}/ntdll_test.units")
  w10x_skip("${_exe_dir}/ntdll_test.units missing (written by wine-pe/tests/ntdll.sh build)")
  return()
endif()

file(STRINGS "${_exe_dir}/ntdll_test.units" _units)
list(REMOVE_ITEM _units "")

# The allowlist: "<unit> <floor>" lines.
set(_allowed "")
file(STRINGS "${ALLOWLIST}" _alines)
foreach(_l IN LISTS _alines)
  string(STRIP "${_l}" _l)
  if(_l STREQUAL "" OR _l MATCHES "^#")
    continue()
  endif()
  if(NOT _l MATCHES "^([A-Za-z0-9_]+)[ \t]+([0-9]+)$")
    message(FATAL_ERROR "${ALLOWLIST}: cannot parse '${_l}' (want '<unit> <min executed>')")
  endif()
  list(APPEND _allowed "${CMAKE_MATCH_1}")
  set(_floor_${CMAKE_MATCH_1} ${CMAKE_MATCH_2})
endforeach()

# The parity list: "<unit> <floor>" lines, as the allowlist.
set(_parity "")
if(PARITY AND EXISTS "${PARITY}")
  file(STRINGS "${PARITY}" _plines)
  foreach(_l IN LISTS _plines)
    string(STRIP "${_l}" _l)
    if(_l STREQUAL "" OR _l MATCHES "^#")
      continue()
    endif()
    if(NOT _l MATCHES "^([A-Za-z0-9_]+)[ \t]+([0-9]+)([ \t]+measure)?$")
      message(FATAL_ERROR "${PARITY}: cannot parse '${_l}' (want '<unit> <min executed> [measure]')")
    endif()
    list(APPEND _parity "${CMAKE_MATCH_1}")
    set(_pfloor_${CMAKE_MATCH_1} ${CMAKE_MATCH_2})
    if(CMAKE_MATCH_3)
      set(_pmeasure_${CMAKE_MATCH_1} TRUE)   # run as on Windows and compared, but not a gate (docs/slices/wt-ntdll-rest.md)
    endif()
  endforeach()
endif()

file(MAKE_DIRECTORY "${MACHINE}/guest-wine" "${RESULTS_DIR}")
file(COPY_FILE "${EXE}" "${MACHINE}/guest-wine/ntdll_test.exe" ONLY_IF_DIFFERENT)

set(_machine "${MACHINE}")
if(EMULATOR AND _machine MATCHES "^/")
  set(_machine "Z:${_machine}")   # Wine: Z: is the Unix root
endif()
string(REPLACE "/" "\\" _machine "${_machine}")

set(_re "([0-9]+) tests executed \\(([0-9]+) marked as todo, ([0-9]+) as flaky, ([0-9]+) failures?\\), ([0-9]+) skipped")
set(ENV{WIN10XBOX_DEBUG} "-all")   # relay tracing would bury the test output

# Units whose crash is being diagnosed (docs/slices/wt-ntdll-rest.md): a unit of this list that does not complete is
# run once more with the relay trace on, and the tail of that trace and the host's crash record go to
# <RESULTS_DIR>/<unit>.relay.log and <unit>.crash.txt (the windows-<config>-logs artifact).
set(_trace_units exception info pipe sync threadpool virtual wow64)
get_filename_component(_host_dir "${HOST}" DIRECTORY)

set(_problems "")
set(_table "| unit | gate | outcome | executed | failed | todo | skipped | exit | s |\n|---|---|---|---:|---:|---:|---:|---:|---:|\n")
set(_todo "")
set(_gated_ok 0)
set(_parity_ok 0)

foreach(_u IN LISTS _units)
  list(FIND _allowed "${_u}" _idx)
  list(FIND _parity "${_u}" _wp)
  if(_idx GREATER -1)
    set(_gated TRUE)
    set(_to ${TIMEOUT})
  else()
    set(_gated FALSE)
    if(NOT SURVEY AND _wp EQUAL -1)
      continue()
    endif()
    if(_wp GREATER -1)
      set(_to ${TIMEOUT})   # a parity unit is a gate
      if(_pmeasure_${_u})
        set(_to 60)         # measured only: a unit that leaves children behind must not hold the run for minutes
      endif()
    else()
      set(_to ${SURVEY_TIMEOUT})
    endif()
  endif()

  set(_log "${RESULTS_DIR}/${_u}.log")
  set(_platform_arg "")
  if(_wp GREATER -1)
    set(_platform_arg "--platform=windows")
  endif()
  set(_cmd ${EMULATOR} "${HOST}" --machine "${_machine}" "C:\\guest-wine\\ntdll_test.exe" "${_u}" ${_platform_arg})
  file(REMOVE "${MACHINE}/registry-overlay.bin")   # each unit starts from the registry of the hives (persistence)
  set(_cmd ${EMULATOR} "${HOST}" --machine "${_machine}" "C:\\guest-wine\\ntdll_test.exe" "${_u}")
  if(CMAKE_HOST_UNIX)
    find_program(_timeout_tool timeout)
    if(_timeout_tool)
      set(_cmd ${_timeout_tool} -k 5 ${_to} ${_cmd})
    endif()
    set(_stdin INPUT_FILE /dev/null)
  else()
    set(_stdin "")
  endif()
  math(EXPR _cmake_to "${_to} + 15")
  list(FIND _trace_units "${_u}" _tr)
  if(_tr GREATER -1)
    file(REMOVE "${_host_dir}/crash.txt")
  endif()
  string(TIMESTAMP _t0 "%s")
  execute_process(COMMAND ${_cmd} RESULT_VARIABLE _rc OUTPUT_FILE "${_log}" ERROR_VARIABLE _err
    TIMEOUT ${_cmake_to} ${_stdin})
  string(TIMESTAMP _t1 "%s")
  math(EXPR _secs "${_t1} - ${_t0}")

  # Head and tail only: a unit that loops prints millions of lines before the cap.
  file(SIZE "${_log}" _size)
  file(READ "${_log}" _head LIMIT 300000)
  set(_tail "${_head}")
  if(_size GREATER 300000)
    math(EXPR _off "${_size} - 65536")
    file(READ "${_log}" _tail OFFSET ${_off} LIMIT 65536)
    file(WRITE "${_log}" "${_head}\n[... ${_size} bytes of output, middle dropped ...]\n${_tail}")
  endif()

  set(_executed 0)
  set(_todo_n 0)
  set(_failed 0)
  set(_skipped 0)
  w10x_pick_summary("${_tail}")
  if(W10X_FOUND)
    set(_outcome ok)
    set(_executed ${W10X_EXEC})
    set(_todo_n ${W10X_TODO})
    set(_failed ${W10X_FAILED})
    set(_skipped ${W10X_SKIPPED})
  elseif(_rc STREQUAL "124" OR _rc STREQUAL "137" OR _rc MATCHES "timeout")
    set(_outcome timeout)
  else()
    set(_outcome crashed)
  endif()

  if(_tr GREATER -1)
    if(EXISTS "${_host_dir}/crash.txt")
      file(COPY_FILE "${_host_dir}/crash.txt" "${RESULTS_DIR}/${_u}.crash.txt")
    endif()
    if(NOT _outcome STREQUAL "ok")
      w10x_summarize("layer" "${_u}" "${_log}" "${_rc}")
      message("---- stderr of ntdll:${_u} ----\n${_err}\n----")
      set(ENV{WIN10XBOX_DEBUG} "-all,+relay,+dispatch,+process")
      set(_dbg "${RESULTS_DIR}/${_u}.relay.log")
      execute_process(COMMAND ${_cmd} RESULT_VARIABLE _rc3 OUTPUT_FILE "${_dbg}.out" ERROR_FILE "${_dbg}"
        TIMEOUT ${_cmake_to} ${_stdin})
      set(ENV{WIN10XBOX_DEBUG} "-all")
      if(EXISTS "${_dbg}")
        file(SIZE "${_dbg}" _fs)
        if(_fs GREATER 150000)
          math(EXPR _o "${_fs} - 150000")
          file(READ "${_dbg}" _tl OFFSET ${_o} LIMIT 150000)
        else()
          file(READ "${_dbg}" _tl)
        endif()
        file(WRITE "${_dbg}" "[${_fs} bytes, exit ${_rc3}, tail]\n${_tl}")
      endif()
    endif()
  endif()

  # The first failing assertions (one per source line), or where a crash/hang stopped.
  string(REPLACE ";" "," _h "${_head}")
  string(REPLACE "[" "(" _h "${_h}")
  string(REPLACE "]" ")" _h "${_h}")
  string(REGEX MATCHALL "[A-Za-z0-9_]+\\.c:[0-9]+: Test failed:[^\n]*" _fails "${_h}")
  set(_seen "")
  set(_first "")
  foreach(_f IN LISTS _fails)
    string(REGEX MATCH "^[A-Za-z0-9_]+\\.c:[0-9]+" _key "${_f}")
    list(FIND _seen "${_key}" _k)
    if(_k EQUAL -1)
      list(APPEND _seen "${_key}")
      string(SUBSTRING "${_f}" 0 200 _f)
      string(REGEX REPLACE "[\r\n]+$" "" _f "${_f}")
      list(APPEND _first "${_f}")
    endif()
  endforeach()
  list(LENGTH _seen _nseen)
  list(LENGTH _first _nfirst)
  if(_nfirst GREATER 6)
    list(SUBLIST _first 0 6 _first)
  endif()
  set(_last "")
  string(REPLACE ";" "," _t "${_tail}")
  string(REPLACE "[" "(" _t "${_t}")
  string(REPLACE "]" ")" _t "${_t}")
  string(REGEX MATCHALL "[A-Za-z0-9_]+\\.c:[0-9]+:[^\n]*" _lines "${_t}")
  if(_lines)
    list(GET _lines -1 _last)
    string(SUBSTRING "${_last}" 0 200 _last)
    string(REGEX REPLACE "[\r\n]+$" "" _last "${_last}")
  endif()
  if(_err MATCHES "win10xbox: [^\n]*")
    set(_layer_err "${CMAKE_MATCH_0}")
  else()
    set(_layer_err "")
  endif()

  # A guest that died before it printed anything: rerun it once with the layer's trace on (the cause is in the
  # last lines and the list of modules it loaded), unless that was already done for another unit.
  if(NOT _outcome STREQUAL "ok" AND _size EQUAL 0 AND NOT _traced)
    set(_traced TRUE)
    set(ENV{WIN10XBOX_DEBUG} "+all")
    set(_dbg "${RESULTS_DIR}/${_u}.trace.log")
    execute_process(COMMAND ${_cmd} RESULT_VARIABLE _rc2 OUTPUT_FILE "${_dbg}" ERROR_FILE "${_dbg}.err"
      TIMEOUT ${_cmake_to} ${_stdin})
    set(ENV{WIN10XBOX_DEBUG} "-all")
    foreach(_f "${_dbg}" "${_dbg}.err")
      if(EXISTS "${_f}")
        file(SIZE "${_f}" _fs)
        if(_fs GREATER 80000)
          math(EXPR _o "${_fs} - 30000")
          file(READ "${_f}" _tl OFFSET ${_o} LIMIT 30000)
        else()
          file(READ "${_f}" _tl)
        endif()
        message("---- trace of ntdll:${_u} (exit ${_rc2}), ${_f}: ${_fs} bytes, tail ----\n${_tl}\n---- end of trace ----")
        file(WRITE "${_f}" "${_tl}")
      endif()
    endforeach()
  endif()

  set(_verdict "survey")
  if(_gated)
    set(_verdict "ok")
    if(NOT _outcome STREQUAL "ok")
      set(_verdict "FAIL: ${_outcome} (allowlisted units must complete); last: ${_last} ${_layer_err}")
    elseif(_failed GREATER 0)
      set(_verdict "FAIL: ${_failed} failures")
    elseif(_executed LESS ${_floor_${_u}})
      set(_verdict "FAIL: ${_executed} assertions executed, floor ${_floor_${_u}}")
    endif()
    if(_verdict STREQUAL "ok")
      math(EXPR _gated_ok "${_gated_ok} + 1")
    else()
      list(APPEND _problems "ntdll:${_u} ${_verdict}")
      foreach(_f IN LISTS _first)
        message("  ${_f}")
      endforeach()
    endif()
  elseif(_outcome STREQUAL "ok" AND _failed EQUAL 0 AND _executed GREATER 0)
    set(_verdict "survey: PASSES, add it to the allowlist")
  endif()
  if(_gated)
    set(_g yes)
  else()
    set(_g no)
  endif()
  message("WINETEST ntdll:${_u} gate=${_g} outcome=${_outcome} executed=${_executed} failed=${_failed} "
          "todo=${_todo_n} skipped=${_skipped} exit=${_rc} time=${_secs}s -> ${_verdict}")
  string(APPEND _table "| ${_u} | ${_g} | ${_outcome} | ${_executed} | ${_failed} | ${_todo_n} | ${_skipped} | ${_rc} | ${_secs} |\n")
  file(WRITE "${RESULTS_DIR}/${_u}.tsv"
    "${_u}\t${_g}\t${_outcome}\t${_executed}\t${_failed}\t${_todo_n}\t${_skipped}\t${_rc}\t${_secs}\n")
  # Parity units (see the header): the same binary on the host itself, no layer, then the layer a second time.
  if(_wp GREATER -1)
    set(_native_ok FALSE)
    if(NOT EMULATOR AND CMAKE_HOST_WIN32)
      execute_process(COMMAND "${EXE}" "${_u}" --platform=windows RESULT_VARIABLE _nrc
        OUTPUT_FILE "${RESULTS_DIR}/${_u}.native.log" ERROR_VARIABLE _nerr TIMEOUT 120)
      w10x_summarize("native" "${_u}" "${RESULTS_DIR}/${_u}.native.log" "${_nrc}")
      file(READ "${RESULTS_DIR}/${_u}.native.log" _ntext LIMIT 400000)
      w10x_pick_summary("${_ntext}")
      if(W10X_FOUND)
        set(_native_ok TRUE)
      endif()
    endif()
    execute_process(COMMAND ${_cmd} RESULT_VARIABLE _rrc OUTPUT_FILE "${RESULTS_DIR}/${_u}.repeat.log"
      ERROR_VARIABLE _rerr TIMEOUT ${_cmake_to} ${_stdin})
    w10x_summarize("layer, second run" "${_u}" "${RESULTS_DIR}/${_u}.repeat.log" "${_rrc}")
    if(NOT EMULATOR AND CMAKE_HOST_WIN32)
      set(_pv "ok")
      if(NOT _native_ok)
        set(_pv "FAIL: the native run did not finish, nothing to compare with (exit ${_nrc})")
      elseif(NOT _outcome STREQUAL "ok")
        set(_pv "FAIL: ${_outcome} (the unit must complete); last: ${_last} ${_layer_err}")
      elseif(_executed LESS ${_pfloor_${_u}})
        set(_pv "FAIL: ${_executed} assertions executed, floor ${_pfloor_${_u}}")
      else()
        w10x_failing_keys("${_log}" _fkeys)
        w10x_failing_keys("${RESULTS_DIR}/${_u}.repeat.log" _rkeys)
        w10x_failing_keys("${RESULTS_DIR}/${_u}.native.log" _nkeys)
        set(_worse "")
        foreach(_k IN LISTS _fkeys)
          list(FIND _rkeys "${_k}" _in2)
          list(FIND _nkeys "${_k}" _inn)
          if(_in2 GREATER -1 AND _inn EQUAL -1)
            list(APPEND _worse "${_k}")
          elseif(_inn EQUAL -1)
            message("  parity: ${_k} failed in one layer run only (flaky, not counted)")
          endif()
        endforeach()
        if(_worse)
          string(REPLACE ";" " " _worse "${_worse}")
          set(_pv "FAIL: assertions that Windows passes and the layer fails: ${_worse}")
        endif()
      endif()
      if(_pmeasure_${_u})
        message("WINETEST parity ntdll:${_u} (measured, not a gate) -> ${_pv}")
      else()
        message("WINETEST parity ntdll:${_u} -> ${_pv}")
      endif()
      if(_pmeasure_${_u})
        # nothing to enforce
      elseif(NOT _pv STREQUAL "ok")
        list(APPEND _problems "ntdll:${_u} parity ${_pv}")
      else()
        math(EXPR _parity_ok "${_parity_ok} + 1")
      endif()
    else()
      message("WINETEST parity ntdll:${_u} not gated: it is compared with a native run, which needs a Windows host")
    endif()
  endif()
  if(NOT _gated AND NOT (_outcome STREQUAL "ok" AND _failed EQUAL 0))
    string(APPEND _todo "\n### ${_u}: ${_outcome}, ${_executed} executed, ${_failed} failed, ${_nseen} distinct failing lines in the first 300 kB\n")
    foreach(_f IN LISTS _first)
      string(APPEND _todo "- `${_f}`\n")
    endforeach()
    if(NOT _outcome STREQUAL "ok" AND _last)
      string(APPEND _todo "- stopped after: `${_last}`\n")
    endif()
    if(_layer_err)
      string(APPEND _todo "- host: `${_layer_err}`\n")
    endif()
  endif()
endforeach()

file(WRITE "${RESULTS_DIR}/summary.md"
  "## Wine ntdll conformance through the layer\n\n${_table}\n### Units not on the allowlist (todo)\n${_todo}")
message("\n${_table}")
if(_todo)
  message("TODO (units not on the allowlist):\n${_todo}")
endif()

if(_problems)
  string(REPLACE ";" "\n  " _p "${_problems}")
  message(FATAL_ERROR "allowlisted ntdll units failed:\n  ${_p}")
endif()
list(LENGTH _allowed _nallowed)
if(_gated_ok LESS _nallowed)
  message(FATAL_ERROR "only ${_gated_ok} of ${_nallowed} allowlisted units ran: is one missing from ntdll_test.units?")
endif()
message("PASS: ${_gated_ok} allowlisted ntdll units, 0 failures; ${_parity_ok} parity units")

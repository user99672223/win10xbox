# integration.real_tcc: TinyCC (built by tools/ci/build_tcc.ps1 into <machine>/guest/tcc) compiles hello.c to
# hello.exe inside the layer's VFS, then the produced hello.exe runs through the layer too.
#   -DHOST=<win10xbox.exe> -DMACHINE=<machine dir> -DSOURCE=<hello.c> [-DEMULATOR=<wine>]
foreach(f Windows/builtin/ntdll.dll Windows/System32/c_1252.nls guest/tcc/tcc.exe)
  if(NOT EXISTS "${MACHINE}/${f}")
    message("SKIP: ${MACHINE}/${f} missing")
    cmake_language(EXIT 77)
  endif()
endforeach()
file(COPY "${SOURCE}" DESTINATION "${MACHINE}/guest/tcc")
file(REMOVE "${MACHINE}/guest/tcc/hello.exe")
set(_machine "${MACHINE}")
if(EMULATOR AND _machine MATCHES "^/")
  set(_machine "Z:${_machine}")
endif()
string(REPLACE "/" "\\" _machine "${_machine}")
function(run_step what expect_rc expect_re)
  execute_process(COMMAND ${EMULATOR} "${HOST}" --machine "${_machine}" ${ARGN}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180)
  message("--- ${what}: exit ${rc} ---\n${out}")
  if(err)
    string(LENGTH "${err}" _n)
    if(_n GREATER 8000)
      string(SUBSTRING "${err}" 0 8000 err)
    endif()
    message("--- stderr ---\n${err}")
  endif()
  if(NOT "${rc}" STREQUAL "${expect_rc}")
    message(FATAL_ERROR "${what}: exit code ${rc}, expected ${expect_rc}")
  endif()
  if(expect_re AND NOT out MATCHES "${expect_re}")
    message(FATAL_ERROR "${what}: stdout does not match '${expect_re}'")
  endif()
endfunction()
run_step("tcc compile" 0 "" "C:\\guest\\tcc\\tcc.exe" "-o" "C:\\guest\\tcc\\hello.exe" "C:\\guest\\tcc\\hello.c")
if(NOT EXISTS "${MACHINE}/guest/tcc/hello.exe")
  message(FATAL_ERROR "tcc exited 0 but ${MACHINE}/guest/tcc/hello.exe was not written")
endif()
run_step("hello.exe" 42 "hello from tcc 42" "C:\\guest\\tcc\\hello.exe")
message("PASS: real_tcc")

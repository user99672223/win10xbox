# Real program: 7-Zip's console 7zr.exe (built by tools/ci/build_7zip.ps1 into <machine>/guest) through win10xbox.
#   cmake -DHOST=<win10xbox.exe> -DMACHINE=<machine dir> [-DEMULATOR=<wine>] [-DMODE=roundtrip|bench] -P real7z.cmake
# MODE=roundtrip (default): generates a ~4 MB file set under <machine>/work7z/in, then through the layer:
#   7zr a  (LZMA2, -mmt=4, 64 KiB dictionary so the 4 MB are split into 1 MiB blocks compressed on 4 threads)
#   7zr a  (LZMA, -mmt=4: the multithreaded match finder)
#   7zr t / 7zr l / 7zr x  of both archives, and compares SHA-256 of every extracted file with the original.
# MODE=bench: 7zr b -mmt1 (the built-in LZMA benchmark; it must finish and print its Avr:/Tot: rating lines).
# WIN10XBOX_DEBUG is "-all,+wine" unless REAL7Z_DEBUG is set (a 4 MB compression under +all is gigabytes of trace);
# Wine's own err/fixme lines and the DLL loads come through WIN10XBOX_WINEDEBUG (REAL7Z_WINEDEBUG overrides it).
# Like run_guest.cmake: "SKIP:" and exit 77 when the machine folder has no Wine builtins / NLS data. A missing host or
# a missing 7zr.exe is a failure, never a skip.
if(NOT MODE)
  set(MODE roundtrip)
endif()
if(NOT EXISTS "${HOST}")
  message(FATAL_ERROR "real7z: host ${HOST} does not exist")
endif()
if(NOT EXISTS "${MACHINE}/Windows/builtin/ntdll.dll")
  message("SKIP: ${MACHINE}/Windows/builtin/ntdll.dll missing: build Wine's PE DLLs (wine-pe/build.sh) "
          "or download the wine-pe artifact into the machine folder")
  if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.29)
    cmake_language(EXIT 77)
  endif()
  return()
endif()
if(NOT EXISTS "${MACHINE}/Windows/System32/c_1252.nls")
  message("SKIP: ${MACHINE}/Windows/System32/c_1252.nls missing: the guest's ntdll needs the Windows NLS data "
          "(machine/import_windows_dlls.ps1 stages it from a Windows install; not available on Linux)")
  if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.29)
    cmake_language(EXIT 77)
  endif()
  return()
endif()
if(NOT EXISTS "${MACHINE}/guest/7zr.exe")
  message(FATAL_ERROR "real7z: ${MACHINE}/guest/7zr.exe missing (tools/ci/build_7zip.ps1)")
endif()

set(_machine "${MACHINE}")
if(EMULATOR AND _machine MATCHES "^/")
  set(_machine "Z:${_machine}")
endif()
string(REPLACE "/" "\\" _machine "${_machine}")
if(DEFINED ENV{REAL7Z_DEBUG})
  set(ENV{WIN10XBOX_DEBUG} "$ENV{REAL7Z_DEBUG}")
else()
  set(ENV{WIN10XBOX_DEBUG} "-all,+wine")
endif()
if(DEFINED ENV{REAL7Z_WINEDEBUG})
  set(ENV{WIN10XBOX_WINEDEBUG} "$ENV{REAL7Z_WINEDEBUG}")
else()
  set(ENV{WIN10XBOX_WINEDEBUG} "err+all,fixme+all,+loaddll")
endif()

# The layer's trace goes to stderr: print it without the host-module inventory, the first and last 6000 characters.
function(show_stderr text)
  string(REGEX REPLACE "host-win32: host module [^\n]*\n" "" text "${text}")
  string(LENGTH "${text}" _el)
  if(_el GREATER 12000)
    string(SUBSTRING "${text}" 0 6000 _head)
    math(EXPR _from "${_el} - 6000")
    string(SUBSTRING "${text}" ${_from} 6000 _tail)
    set(text "${_head}\n[... ${_el} characters of trace, middle left out ...]\n${_tail}")
  endif()
  message("--- stderr ---\n${text}")
endfunction()

# host-win32 writes crash.txt next to win10xbox.exe on a fatal exception; a later run would overwrite it.
function(show_crash)
  get_filename_component(_host_dir "${HOST}" DIRECTORY)
  if(EXISTS "${_host_dir}/crash.txt")
    file(TIMESTAMP "${_host_dir}/crash.txt" _crash_time "%s")
    string(TIMESTAMP _now "%s")
    math(EXPR _age "${_now} - ${_crash_time}")
    if(_age LESS 120)
      file(READ "${_host_dir}/crash.txt" _crash)
      message("--- crash.txt ---\n${_crash}")
    endif()
  endif()
endfunction()

if(MODE STREQUAL "bench")
  execute_process(COMMAND ${EMULATOR} "${HOST}" --machine "${_machine}" "C:\\guest\\7zr.exe" b -mmt1
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 800)
  string(REPLACE "\r\n" "\n" out "${out}")
  message("=== 7zr b -mmt1 -> exit ${rc}\n${out}")
  if(err)
    show_stderr("${err}")
  endif()
  if(NOT "${rc}" STREQUAL "0")
    message(SEND_ERROR "7zr b -mmt1: exit code ${rc}, expected 0")
    show_crash()
  endif()
  foreach(re "Avr:" "Tot:" "Compressing" "Decompressing")
    if(NOT out MATCHES "${re}")
      message(SEND_ERROR "7zr b -mmt1: stdout does not match '${re}'")
    endif()
  endforeach()
  if(out MATCHES "[Ee][Rr][Rr][Oo][Rr]")
    message(SEND_ERROR "7zr b -mmt1 printed an error")
  endif()
  message("real7z: bench done")
  return()
endif()

# ---- the file set ------------------------------------------------------------------------------------------
set(_work "${MACHINE}/work7z")
file(REMOVE_RECURSE "${_work}")
file(MAKE_DIRECTORY "${_work}/in/sub" "${_work}/out_lzma2" "${_work}/out_lzma")
set(_chunks "")
foreach(i RANGE 0 63)
  string(RANDOM LENGTH 1024 ALPHABET "abcdefghijklmnopqrstuvwxyz0123456789 \n" RANDOM_SEED ${i} _c)
  set(_chunk${i} "${_c}")
endforeach()
set(_names a.txt b.txt c.txt sub/d.txt)
set(_seed 12345)
foreach(n ${_names})
  set(_f "${_work}/in/${n}")
  file(WRITE "${_f}" "")
  foreach(k RANGE 1 1024)
    math(EXPR _seed "(${_seed} * 1103515245 + 12345) % 2147483648")
    math(EXPR _idx "(${_seed} / 65536) % 64")
    file(APPEND "${_f}" "${_chunk${_idx}}")
  endforeach()
endforeach()
file(WRITE "${_work}/in/empty.bin" "")
set(_total 0)
foreach(n ${_names} empty.bin)
  file(SIZE "${_work}/in/${n}" _sz)
  math(EXPR _total "${_total} + ${_sz}")
  file(SHA256 "${_work}/in/${n}" _h_${n})
endforeach()
message("real7z: generated ${_total} bytes in 5 files")
if(_total LESS 4000000)
  message(FATAL_ERROR "real7z: file set smaller than expected (${_total})")
endif()

# ---- running 7zr ---------------------------------------------------------------------------------------------
set(_fail "")
set(_log "")
set(_retraced FALSE)
function(run7z label expect_rc expect_regex)
  execute_process(COMMAND ${EMULATOR} "${HOST}" --machine "${_machine}" "C:\\guest\\7zr.exe" ${ARGN}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 500)
  message("=== 7zr ${ARGN} -> exit ${rc}\n${out}")
  if(err)
    show_stderr("${err}")
  endif()
  if(NOT "${rc}" STREQUAL "${expect_rc}")
    message(SEND_ERROR "${label}: exit code ${rc}, expected ${expect_rc}")
    show_crash()
    # Once per run: the same command again with the syscall trace, the last part of it (what the guest did before it died).
    if(NOT _retraced)
      set(_retraced TRUE PARENT_SCOPE)
      set(ENV{WIN10XBOX_DEBUG} "-all,+wine,+relay,+process")
      execute_process(COMMAND ${EMULATOR} "${HOST}" --machine "${_machine}" "C:\\guest\\7zr.exe" ${ARGN}
        RESULT_VARIABLE _rc2 OUTPUT_VARIABLE _out2 ERROR_VARIABLE _err2 TIMEOUT 500)
      set(ENV{WIN10XBOX_DEBUG} "-all,+wine")
      string(LENGTH "${_err2}" _l2)
      if(_l2 GREATER 14000)
        math(EXPR _from "${_l2} - 14000")
        string(SUBSTRING "${_err2}" ${_from} 14000 _err2)
      endif()
      message("--- retraced with +relay,+process (exit ${_rc2}), last 14000 characters of stderr ---\n${_err2}")
      show_crash()
    endif()
  endif()
  foreach(re ${expect_regex})
    if(NOT out MATCHES "${re}")
      message(SEND_ERROR "${label}: stdout does not match '${re}'")
    endif()
  endforeach()
endfunction()

run7z("version" 0 "7-Zip \\(r\\)" "-h")

set(_a2 "C:\\work7z\\lzma2.7z")
set(_al "C:\\work7z\\lzma.7z")
run7z("a lzma2" 0 "Everything is Ok" a ${_a2} C:\\work7z\\in\\* -r -y -mx=5 -m0=lzma2:d=64k -mmt=4)
run7z("a lzma" 0 "Everything is Ok" a ${_al} C:\\work7z\\in\\* -r -y -mx=5 -m0=lzma:d=1m -mmt=4)
foreach(a lzma2 lzma)
  file(SIZE "${_work}/${a}.7z" _asz)
  message("real7z: ${a}.7z is ${_asz} bytes")
  if(_asz LESS 1000 OR NOT _asz LESS _total)
    message(SEND_ERROR "${a}.7z size ${_asz} implausible for ${_total} input bytes")
  endif()
endforeach()
run7z("t lzma2" 0 "Everything is Ok;Files: 5" t ${_a2} -mmt=4)
run7z("t lzma" 0 "Everything is Ok;Files: 5" t ${_al} -mmt=4)
run7z("l" 0 "a\\.txt;sub.d\\.txt;empty\\.bin" l ${_a2})
run7z("x lzma2" 0 "Everything is Ok" x ${_a2} -oC:\\work7z\\out_lzma2 -y -mmt=4)
run7z("x lzma" 0 "Everything is Ok" x ${_al} -oC:\\work7z\\out_lzma -y -mmt=4)

# ---- compare -------------------------------------------------------------------------------------------------
foreach(o out_lzma2 out_lzma)
  foreach(n ${_names} empty.bin)
    if(NOT EXISTS "${_work}/${o}/${n}")
      message(SEND_ERROR "${o}/${n} was not extracted")
    else()
      file(SHA256 "${_work}/${o}/${n}" _got)
      if(NOT "${_got}" STREQUAL "${_h_${n}}")
        message(SEND_ERROR "${o}/${n}: SHA-256 ${_got}, expected ${_h_${n}}")
      else()
        message("real7z: ${o}/${n} sha256 ok")
      endif()
    endif()
  endforeach()
endforeach()
# A file that is not an archive must be rejected with a non-zero exit.
file(WRITE "${_work}/notarchive.7z" "this is not a 7z archive\n")
execute_process(COMMAND ${EMULATOR} "${HOST}" --machine "${_machine}" "C:\\guest\\7zr.exe" t C:\\work7z\\notarchive.7z
  RESULT_VARIABLE _rc OUTPUT_VARIABLE _o ERROR_VARIABLE _e TIMEOUT 120)
message("=== 7zr t notarchive.7z -> exit ${_rc}\n${_o}")
if("${_rc}" STREQUAL "0")
  message(SEND_ERROR "7zr t accepted a file that is not an archive")
endif()

message("real7z: done")

# Runs a guest program against drivers loaded by drv_host (cmake -P).
#   -DHOST=<drv_host.exe> -DMACHINE=<machine dir> -DDRIVER=<x.sys> -DCLIENT=<client.exe>
#   -DGUEST_NAME=<name on C:\guest> -DEXPECT_EXIT=<n> -DEXPECT_REGEX=<regex;regex...> [-DEMULATOR=<wine>]
# SKIP (exit 77) when the machine folder has no Wine builtins or NLS data, exactly like
# tests/integration/run_guest.cmake, or when the driver / client were not built.
foreach(_f "${DRIVER}" "${CLIENT}" "${HOST}")
  if(NOT EXISTS "${_f}")
    message("SKIP: ${_f} was not built")
    if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.29)
      cmake_language(EXIT 77)
    endif()
    return()
  endif()
endforeach()
if(NOT EXISTS "${MACHINE}/Windows/builtin/ntdll.dll")
  message("SKIP: ${MACHINE}/Windows/builtin/ntdll.dll missing: build Wine's PE DLLs (wine-pe/build.sh) "
          "or download the wine-pe artifact into the machine folder")
  if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.29)
    cmake_language(EXIT 77)
  endif()
  return()
endif()
if(NOT EXISTS "${MACHINE}/Windows/System32/c_1252.nls")
  message("SKIP: ${MACHINE}/Windows/System32/c_1252.nls missing: the guest's ntdll needs the Windows NLS data "
          "(machine/import_windows_dlls.ps1 stages it from a Windows install; not available on Linux)")
  if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.29)
    cmake_language(EXIT 77)
  endif()
  return()
endif()

# Stage the driver and the client into the machine folder (the guest's C:\).
get_filename_component(_drv_name "${DRIVER}" NAME)
file(MAKE_DIRECTORY "${MACHINE}/Windows/System32/drivers" "${MACHINE}/guest")
file(COPY_FILE "${DRIVER}" "${MACHINE}/Windows/System32/drivers/${_drv_name}" ONLY_IF_DIFFERENT)
file(COPY_FILE "${CLIENT}" "${MACHINE}/guest/${GUEST_NAME}" ONLY_IF_DIFFERENT)

set(_machine "${MACHINE}")
set(_driver "${MACHINE}/Windows/System32/drivers/${_drv_name}")
if(EMULATOR AND _machine MATCHES "^/")
  set(_machine "Z:${_machine}")
  set(_driver "Z:${_driver}")
endif()
string(REPLACE "/" "\\" _machine "${_machine}")
string(REPLACE "/" "\\" _driver "${_driver}")
set(_cmd ${EMULATOR} "${HOST}" --machine "${_machine}" --driver "${_driver}" "C:\\guest\\${GUEST_NAME}")
if(DEBUG_SPEC)
  set(ENV{WIN10XBOX_DEBUG} "${DEBUG_SPEC}")
endif()
execute_process(COMMAND ${_cmd} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 150)
message("${out}")
if(err)
  message("--- stderr ---\n${err}")
endif()
set(_fail "")
if(NOT "${rc}" STREQUAL "${EXPECT_EXIT}")
  string(APPEND _fail "exit code ${rc}, expected ${EXPECT_EXIT}\n")
endif()
foreach(re ${EXPECT_REGEX})
  if(NOT out MATCHES "${re}")
    string(APPEND _fail "stdout does not match '${re}'\n")
  endif()
endforeach()
if(FORBID_REGEX AND out MATCHES "${FORBID_REGEX}")
  string(APPEND _fail "stdout matches forbidden '${FORBID_REGEX}'\n")
endif()
if(_fail)
  message(FATAL_ERROR "${GUEST_NAME}:\n${_fail}")
endif()
message("PASS: ${GUEST_NAME} (exit ${rc})")

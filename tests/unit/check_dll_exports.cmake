# cmake -DDLL=<dll> -DEXPECTED_DOC=<docs/slices/xinput2.md> [-DOBJDUMP=<llvm-objdump|objdump>] [-DLINKER=<link.exe>] -P
# Compares the DLL's export table (ordinal, name or none) with the `export: <ordinal> <name|->` lines of the doc.
# Exit 77 (SKIP) when no tool can list exports.
if(NOT EXISTS "${DLL}")
  message("SKIP: ${DLL} not built")
  return()
endif()
set(_tool "")
if(OBJDUMP AND EXISTS "${OBJDUMP}")
  execute_process(COMMAND "${OBJDUMP}" -p "${DLL}" OUTPUT_VARIABLE _dump RESULT_VARIABLE _rc)
  set(_tool objdump)
elseif(LINKER AND EXISTS "${LINKER}")
  execute_process(COMMAND "${LINKER}" /dump /exports "${DLL}" OUTPUT_VARIABLE _dump RESULT_VARIABLE _rc)
  set(_tool dumpbin)
endif()
if(NOT _tool OR _rc)
  message("SKIP: no export lister (OBJDUMP='${OBJDUMP}' LINKER='${LINKER}')")
  return()
endif()
string(REPLACE "\r" "" _dump "${_dump}")
string(REPLACE "\n" ";" _lines "${_dump}")
set(_actual "")
foreach(l ${_lines})
  if(_tool STREQUAL "objdump" AND l MATCHES "^ +([0-9]+) +0x[0-9a-f]+ *([A-Za-z0-9_@?]*) *$")
    list(APPEND _actual "${CMAKE_MATCH_1} ${CMAKE_MATCH_2}")
  elseif(_tool STREQUAL "dumpbin" AND l MATCHES "^ +([0-9]+) +[0-9A-Fa-f]+ +[0-9A-Fa-f]+( +([A-Za-z0-9_@?]+))?( .*)?$")
    list(APPEND _actual "${CMAKE_MATCH_1} ${CMAKE_MATCH_3}")
  endif()
endforeach()
# objdump lists the table twice in some versions (address table, name table): de-duplicate.
list(REMOVE_DUPLICATES _actual)
set(_norm "")
foreach(a ${_actual})
  string(REGEX REPLACE " +$" "" a "${a}")
  list(APPEND _norm "${a}")
endforeach()
file(STRINGS "${EXPECTED_DOC}" _doc REGEX "^export: [0-9]+ ")
set(_expected "")
foreach(l ${_doc})
  string(REGEX REPLACE "^export: ([0-9]+) (.*)$" "\\1 \\2" e "${l}")
  string(REGEX REPLACE " -$" "" e "${e}")
  list(APPEND _expected "${e}")
endforeach()
list(SORT _norm COMPARE NATURAL)
list(SORT _expected COMPARE NATURAL)
if(NOT _expected)
  message(FATAL_ERROR "no 'export:' lines in ${EXPECTED_DOC}")
endif()
if(NOT "${_norm}" STREQUAL "${_expected}")
  message(FATAL_ERROR "export table differs from ${EXPECTED_DOC}\n actual:   ${_norm}\n expected: ${_expected}")
endif()
list(LENGTH _norm _n)
message("xinput exports: ${_n} entries match ${EXPECTED_DOC}")

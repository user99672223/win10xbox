# Runs win10xbox.exe once (cmake -P) and checks how the PROCESS ended: its exit code, and what it said on stderr.
# ctest's PASS_REGULAR_EXPRESSION ignores exit codes, which is how a host that died at exit went unnoticed.
#   -DHOST=<win10xbox.exe> [-DEMULATOR=<wine>] -DEXPECT_EXIT=<n>
#   [-DMACHINE=<machine dir> -DPROGRAM=<C:\guest\x.exe>]   a guest run; without them the host is started with no arguments
#   [-DEXPECT_OUT_REGEX=<regex;...>]  stdout      [-DEXPECT_ERR_REGEX=<regex;...>] [-DFORBID_ERR_REGEX=<regex>]  stderr
#   [-DEXIT_PROBE_DLL=<exit_probe.dll>]  WIN10XBOX_TEST_EXIT_PROBE_DLL
#   [-DNORMAL_EXIT=1]                    WIN10XBOX_NORMAL_EXIT        (the CRT -> ExitProcess -> DLL detach way out)
#   [-DHOST_ACTCTX=1]                    WIN10XBOX_TEST_HOST_ACTCTX   (Wine hosts: PEB.ActivationContextData survives the guest)
#   [-DLEAK_ACTCTX=1]                    WIN10XBOX_TEST_LEAK_GUEST_ACTCTX   (core: skip that restore, to show the check sees it)
# Prints "SKIP: ..." and exits 77 (cmake >= 3.29) for a guest run when the machine folder has no Wine builtins or no
# Windows NLS data, exactly like tests/integration/run_guest.cmake; the test sets SKIP_RETURN_CODE 77 and
# SKIP_REGULAR_EXPRESSION "SKIP:".
if(PROGRAM)
  if(NOT EXISTS "${MACHINE}/Windows/builtin/ntdll.dll")
    message("SKIP: ${MACHINE}/Windows/builtin/ntdll.dll missing: build Wine's PE DLLs (wine-pe/build.sh) "
            "or download the wine-pe artifact into the machine folder")
    if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.29)
      cmake_language(EXIT 77)
    endif()
    return()
  endif()
  if(NOT EXISTS "${MACHINE}/Windows/System32/c_1252.nls")
    message("SKIP: ${MACHINE}/Windows/System32/c_1252.nls missing: the guest's ntdll needs the Windows NLS data "
            "(machine/import_windows_dlls.ps1 stages it from a Windows install; not available on Linux)")
    if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.29)
      cmake_language(EXIT 77)
    endif()
    return()
  endif()
endif()

# Paths the Windows side must understand: under Wine, Z: is the Unix root.
function(to_windows_path out in)
  set(p "${in}")
  if(EMULATOR AND p MATCHES "^/")
    set(p "Z:${p}")
  endif()
  string(REPLACE "/" "\\" p "${p}")
  set(${out} "${p}" PARENT_SCOPE)
endfunction()

set(_cmd ${EMULATOR} "${HOST}")
if(PROGRAM)
  string(REPLACE "/" "\\" _program "${PROGRAM}")
  to_windows_path(_machine "${MACHINE}")
  list(APPEND _cmd --machine "${_machine}" "${_program}")
endif()
if(EXIT_PROBE_DLL)
  to_windows_path(_probe "${EXIT_PROBE_DLL}")
  set(ENV{WIN10XBOX_TEST_EXIT_PROBE_DLL} "${_probe}")
endif()
if(NORMAL_EXIT)
  set(ENV{WIN10XBOX_NORMAL_EXIT} "1")
endif()
if(HOST_ACTCTX)
  set(ENV{WIN10XBOX_TEST_HOST_ACTCTX} "1")
endif()
if(LEAK_ACTCTX)
  set(ENV{WIN10XBOX_TEST_LEAK_GUEST_ACTCTX} "1")
endif()

execute_process(COMMAND ${_cmd} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
message("${out}")
if(err)
  message("--- stderr ---\n${err}")
endif()
set(_fail "")
if(NOT "${rc}" STREQUAL "${EXPECT_EXIT}")
  string(APPEND _fail "exit code ${rc}, expected ${EXPECT_EXIT}\n")
endif()
foreach(re ${EXPECT_OUT_REGEX})
  if(NOT out MATCHES "${re}")
    string(APPEND _fail "stdout does not match '${re}'\n")
  endif()
endforeach()
foreach(re ${EXPECT_ERR_REGEX})
  if(NOT err MATCHES "${re}")
    string(APPEND _fail "stderr does not match '${re}'\n")
  endif()
endforeach()
if(FORBID_ERR_REGEX AND err MATCHES "${FORBID_ERR_REGEX}")
  string(APPEND _fail "stderr matches forbidden '${FORBID_ERR_REGEX}'\n")
endif()
if(_fail)
  message(FATAL_ERROR "${HOST} ${PROGRAM}:\n${_fail}")
endif()
message("PASS: exit ${rc}")

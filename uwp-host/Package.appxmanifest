<?xml version="1.0" encoding="utf-8"?>
<!--
  Package.appxmanifest - the UWP manifest for the capability probe. We declare
  every capability worth probing so that any denial we observe is a sandbox
  denial, not a declaration omission:
    * runFullTrust is intentionally NOT declared - probing what plain AppContainer
      allows is the point.
    * codeGeneration (restricted) is required for the dynamic-code tests
      (VirtualAlloc PAGE_EXECUTE_* ends up gated on it).
    * internetClient, internetClientServer, privateNetworkClientServer so the
      network probes can see whether outbound TCP, DNS, inbound listen, and
      loopback are allowed.
    * broadFileSystemAccess so category F can measure out-of-package reads.
    * other common hardware/data capabilities so WinRT activation (category N)
      reports true denials instead of "capability not declared".
  TargetDeviceFamily="Windows.Universal" so the same package deploys to
  the Xbox (Dev Mode); min build 10.0.17134 so VirtualAlloc2 / MapViewOfFile3
  are available on every target.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 mp rescap">

  <Identity Name="XboxDevModeProbe"
            Publisher="CN=Dev"
            Version="1.0.0.0"
            ProcessorArchitecture="x64" />

  <mp:PhoneIdentity PhoneProductId="df3d1f17-dd30-4a9f-9b26-6c9b55e68a30"
                    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Xbox Dev Mode Probe</DisplayName>
    <PublisherDisplayName>Dev</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal"
                        MinVersion="10.0.17134.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- EntryPoint is required by the manifest schema when Executable is set,
         but for a native C++ CoreApplication exe (we are NOT a desktop-bridge
         full-trust app, so no Windows.FullTrustApplication) the value is only
         validated structurally - the system launches the PE and our wWinMain
         calls CoreApplication::Run with our own IFrameworkViewSource. Any
         identifier would satisfy the schema; "App" is the convention used by
         the C++/WinRT sample set. -->
    <Application Id="App" Executable="xbox-probe-uwp.exe" EntryPoint="App">
      <uap:VisualElements DisplayName="Xbox Dev Mode Probe"
                          Description="Capability probe harness for the Xbox AppContainer sandbox."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Code generation: required for VirtualAlloc PAGE_EXECUTE_* under
         AppContainer. The whole category A test depends on this. -->
    <rescap:Capability Name="codeGeneration" />
    <!-- Broad file-system access: required for category F to probe reads of
         System32, C:\, etc. In its absence those probes report DENIED and we
         can't tell if the sandbox refuses the access or if we never asked. -->
    <rescap:Capability Name="broadFileSystemAccess" />
    <!-- Networking - standard trio. -->
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <!-- Devices commonly probed via WinRT. These are plain, not restricted. -->
    <uap:Capability Name="musicLibrary" />
    <uap:Capability Name="videosLibrary" />
    <uap:Capability Name="picturesLibrary" />
    <uap:Capability Name="removableStorage" />
    <DeviceCapability Name="microphone" />
    <DeviceCapability Name="webcam" />
    <DeviceCapability Name="location" />
    <DeviceCapability Name="bluetooth" />
  </Capabilities>
</Package>
